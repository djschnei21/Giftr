# Postgres. Locally: `docker compose up -d`. On Vercel: provisioned by the Neon integration.
DATABASE_URL=postgresql://giftr:giftr@localhost:5432/giftr

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production domain only. Leave unset on Vercel preview deployments.
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional locally; email sign-in links always work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email. Without RESEND_API_KEY, emails are written to the dev outbox at /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM="Giftr <hello@example.com>"

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Public base URL used in emails and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
